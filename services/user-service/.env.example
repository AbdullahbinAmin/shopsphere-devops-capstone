# =============================================================================
# ShopSphere — User Service Configuration
# =============================================================================

PORT=3002
NODE_ENV=development
LOG_LEVEL=info

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopsphere_users
DB_USER=shopsphere_user
DB_PASSWORD=devpassword123
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security & JWT Verification
JWT_SECRET=super-secret-jwt-key-at-least-64-characters-for-production-security-12345
JWT_ISSUER=shopsphere-identity
JWT_AUDIENCE=shopsphere-services

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
