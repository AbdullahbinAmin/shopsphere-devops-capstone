# =============================================================================
# ShopSphere — Cart Service Configuration
# =============================================================================

PORT=3005
NODE_ENV=development
LOG_LEVEL=info

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CART_TTL_SECONDS=604800

# Upstream Services
PRODUCT_SERVICE_URL=http://localhost:3003
INVENTORY_SERVICE_URL=http://localhost:3004

# Security & JWT Verification
JWT_SECRET=super-secret-jwt-key-at-least-64-characters-for-production-security-12345
JWT_ISSUER=shopsphere-identity
JWT_AUDIENCE=shopsphere-services

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
