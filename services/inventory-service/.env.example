# =============================================================================
# ShopSphere — Inventory Service Configuration
# =============================================================================

PORT=3004
NODE_ENV=development
LOG_LEVEL=info

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopsphere_inventory
DB_USER=shopsphere_user
DB_PASSWORD=devpassword123
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Security & JWT Verification
JWT_SECRET=super-secret-jwt-key-at-least-64-characters-for-production-security-12345
JWT_ISSUER=shopsphere-identity
JWT_AUDIENCE=shopsphere-services

# Internal Service Protection
INTERNAL_API_KEY=dev-internal-key-999

# Inventory Rules
RESERVATION_TTL_MINUTES=15

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
