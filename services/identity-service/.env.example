# Identity Service Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Service Configuration
# ===========================================
NODE_ENV=development
PORT=3001
SERVICE_NAME=identity-service
LOG_LEVEL=info

# ===========================================
# Database — PostgreSQL
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopsphere_identity
DB_USER=shopsphere_user
DB_PASSWORD=your_db_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# ===========================================
# JWT Configuration
# ===========================================
# Must be a strong secret — at least 64 characters
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_LONG
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=shopsphere-identity
JWT_AUDIENCE=shopsphere-services

# ===========================================
# Security
# ===========================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Stricter rate limit for auth endpoints
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# ===========================================
# CORS
# ===========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# Service URLs (for inter-service communication)
# ===========================================
USER_SERVICE_URL=http://localhost:3002
