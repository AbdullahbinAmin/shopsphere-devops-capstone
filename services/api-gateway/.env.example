# =============================================================================
# ShopSphere — API Gateway Configuration
# =============================================================================

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Global Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Upstream Microservice URLs
IDENTITY_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
PRODUCT_SERVICE_URL=http://localhost:3003
INVENTORY_SERVICE_URL=http://localhost:3004
CART_SERVICE_URL=http://localhost:3005
ORDER_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008
